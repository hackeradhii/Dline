{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // One deployable: serves the static app AND hosts the rendezvous Durable Object.
  "name": "dline",
  "main": "./src/server/worker.ts",
  "compatibility_date": "2026-10-29",
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Only the signaling socket reaches the Worker; everything else is served as static files.
    "run_worker_first": ["/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RendezvousRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RendezvousRoom"] }],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "upload_source_maps": true,
  // Field tests run on a separate Worker (PLAN.md §6.2): `npm run deploy:staging` builds with
  // `--mode staging` (.env.staging selects this environment) and deploys dline-v4. Durable
  // Object bindings aren't inherited by environments, so they are repeated; the staging Worker has
  // its own namespace, so its rooms never mix with production's.
  "env": {
    "staging": {
      "name": "dline-v4",
      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "RendezvousRoom" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RendezvousRoom"] }]
    }
  }
}
