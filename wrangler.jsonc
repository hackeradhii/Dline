{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // One deployable: serves the static app AND hosts the rendezvous Durable Object.
  "name": "dline-v4",
  "main": "./src/server/worker.ts",
  "compatibility_date": "2026-10-29",
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Only the signaling socket and performance reports reach the Worker; everything else is static.
    "run_worker_first": ["/ws/*", "/api/*"]
  },
  // Performance reports (/api/metrics): at most 30 a minute per IP address.
  "ratelimits": [{ "name": "METRICS_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RendezvousRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RendezvousRoom"] }],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "upload_source_maps": true,
  // Production is dline-v4 (`npm run deploy`). Tests run on the separate `dline` Worker:
  // `npm run deploy:staging` builds with `--mode staging` (.env.staging selects this environment).
  // Durable Object bindings aren't inherited by environments, so they are repeated; the test
  // Worker has its own namespace, so its rooms never mix with production's.
  "env": {
    "staging": {
      "name": "dline",
      "ratelimits": [{ "name": "METRICS_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }],
      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "RendezvousRoom" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RendezvousRoom"] }]
    }
  }
}
