{
  "name": "dline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Peer-to-peer video calls and full-quality photo/video sharing between two devices on different networks.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "vite build --mode staging && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "dup": "jscpd src",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run deps && npm run dup && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/overpass": "^5.3.0",
    "svelte": "^5.57.3",
    "uqr": "^0.1.3",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/vitest-plugin": "^1.4.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jscpd": "^5.4.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  }
}
